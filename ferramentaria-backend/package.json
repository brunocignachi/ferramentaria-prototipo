{
  "name": "ferramentaria-backend",
  "version": "1.0.0",
  "description": "API do Sistema de Gerenciamento de Solicitações — Ferramentaria Metalmecânica (TCC)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:backup": "node db/backup.js",
    "db:restore": "node db/restore.js"
  },
  "nodemonConfig": {
    "ignore": [
      "backups/*",
      "uploads/*"
    ]
  },
  "keywords": [
    "ferramentaria",
    "tcc",
    "express",
    "postgresql"
  ],
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
